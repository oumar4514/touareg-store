* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: "Poppins", sans-serif;
  background: #f7f8fc;
  color: #1d1d1f;
}

a {
  text-decoration: none;
  color: inherit;
}

img {
  max-width: 100%;
  display: block;
}

.container {
  width: min(1100px, 90%);
  margin: 0 auto;
}

.header {
  position: sticky;
  top: 0;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10px);
  border-bottom: 1px solid #eee;
  z-index: 50;
}

.nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 80px;
}

.logo {
  font-size: 1.5rem;
  font-weight: 700;
  color: #111827;
}

nav {
  display: flex;
  gap: 24px;
  color: #374151;
  font-weight: 500;
}

.cart-button {
  background: #111827;
  color: white;
  border: none;
  padding: 12px 18px;
  border-radius: 999px;
  cursor: pointer;
  font-weight: 600;
}

.hero {
  padding: 80px 0 50px;
}

.hero-content {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  gap: 30px;
  align-items: center;
}

.hero-text h1 {
  font-size: clamp(2.4rem, 5vw, 4rem);
  line-height: 1.1;
  margin-bottom: 20px;
}

.hero-text p {
  color: #4b5563;
  font-size: 1.05rem;
  margin-bottom: 25px;
}

.tag {
  display: inline-block;
  color: #7c3aed;
  background: #f3e8ff;
  padding: 8px 12px;
  border-radius: 999px;
  font-size: 0.8rem;
  font-weight: 600;
  margin-bottom: 16px;
}

.primary-btn {
  display: inline-block;
  background: linear-gradient(135deg, #7c3aed, #4f46e5);
  color: white;
  padding: 14px 24px;
  border-radius: 999px;
  font-weight: 600;
}

.hero-card {
  background: white;
  border-radius: 24px;
  padding: 20px;
  box-shadow: 0 20px 45px rgba(15, 23, 42, 0.08);
}

.hero-card h3 {
  margin-bottom: 15px;
}

.hero-card img {
  border-radius: 18px;
  height: 280px;
  object-fit: cover;
  margin-bottom: 14px;
}

.hero-card p {
  color: #374151;
  margin-bottom: 8px;
}

.products {
  padding: 60px 0;
}

.section-title {
  text-align: center;
  margin-bottom: 35px;
}

.section-title p {
  color: #7c3aed;
  font-weight: 600;
  margin-bottom: 8px;
}

.section-title h2 {
  font-size: 2rem;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 24px;
}

.product-card {
  background: white;
  border-radius: 18px;
  overflow: hidden;
  box-shadow: 0 8px 24px rgba(17, 24, 39, 0.05);
  transition: 0.2s ease;
}

.product-card:hover {
  transform: translateY(-5px);
}

.product-card img {
  width: 100%;
  height: 220px;
  object-fit: cover;
}

.product-info {
  padding: 18px;
}

.product-info h3 {
  margin-bottom: 8px;
  font-size: 1.1rem;
}

.product-info p {
  color: #4b5563;
  font-size: 0.92rem;
  margin-bottom: 15px;
}

.product-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.price {
  font-weight: 700;
  font-size: 1.1rem;
}

.add-btn {
  background: #111827;
  color: white;
  border: none;
  border-radius: 999px;
  padding: 10px 16px;
  cursor: pointer;
  font-weight: 600;
}

.about {
  padding: 30px 0 60px;
}

.about-box {
  background: #111827;
  color: white;
  border-radius: 24px;
  padding: 32px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  align-items: center;
}

.contact-box {
  background: white;
  border-radius: 22px;
  padding: 32px;
  box-shadow: 0 10px 24px rgba(17, 24, 39, 0.05);
  margin-bottom: 80px;
}

.cart-panel {
  position: fixed;
  top: 0;
  right: -420px;
  width: 360px;
  height: 100vh;
  background: white;
  box-shadow: -8px 0 30px rgba(0, 0, 0, 0.08);
  transition: right 0.3s ease;
  z-index: 100;
  padding: 20px;
  display: flex;
  flex-direction: column;
}

.cart-panel.open {
  right: 0;
}

.cart-header,
.cart-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.cart-header {
  margin-bottom: 20px;
}

.cart-header button {
  border: none;
  background: #f1f5f9;
  width: 34px;
  height: 34px;
  border-radius: 50%;
  cursor: pointer;
}

#cartItems {
  flex: 1;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.cart-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 0;
  border-bottom: 1px solid #e5e7eb;
}

.cart-item h4 {
  font-size: 0.95rem;
}

.cart-item button {
  border: none;
  background: #fee2e2;
  color: #b91c1c;
  padding: 5px 8px;
  border-radius: 8px;
  cursor: pointer;
}

.checkout-btn {
  background: #111827;
  color: white;
  border: none;
  border-radius: 999px;
  padding: 12px 18px;
  cursor: pointer;
  font-weight: 600;
}

@media (max-width: 768px) {
  nav {
    display: none;
  }

  .hero-content,
  .about-box {
    grid-template-columns: 1fr;
  }

  .cart-panel {
    width: 100%;
    right: -100%;
  }
}